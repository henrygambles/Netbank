{
  "expo": {
    "name": "Netbank",
    "slug": "netbank",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0d0d1a",
    "splash": {
      "backgroundColor": "#0d0d1a",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.netbank.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.netbank.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d0d1a"
      }
    },
    "scheme": "netbank",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Netbank needs access to your photos so you can share images with Sabrina.",
          "cameraPermission": "Netbank needs camera access so you can take photos to share with Sabrina."
        }
      ]
    ]
  }
}
